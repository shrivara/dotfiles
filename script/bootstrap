#!/usr/bin/env bash
# Link tracked configuration files into $HOME.
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
backup_dir="$HOME/.dotfiles-backup/$(date +%Y%m%d%H%M%S)"

show_intro() {
  # Keep logs clean when the script is run non-interactively.
  [[ -t 1 && "${TERM:-dumb}" != "dumb" ]] || return

  local green='' dim='' reset='' width=24 filled empty percent i
  if [[ -z "${NO_COLOR:-}" ]]; then
    green=$'\033[38;5;82m'
    dim=$'\033[2m'
    reset=$'\033[0m'
  fi

  printf '\n  %s╔══════════════════════════════════════╗%s\n' "$green" "$reset"
  printf '  %s║  DOTFILES BIOS  //  REV 1.0          ║%s\n' "$green" "$reset"
  printf '  %s╚══════════════════════════════════════╝%s\n' "$green" "$reset"
  printf '  %s> MOUNTING HOME DIRECTORY%s\n' "$dim" "$reset"

  for ((i = 0; i <= width; i++)); do
    printf -v filled '%*s' "$i" ''
    printf -v empty '%*s' "$((width - i))" ''
    filled=${filled// /█}
    empty=${empty// /░}
    percent=$((i * 100 / width))
    printf '\r  %s[%s%s%s%s] %3d%%' "$green" "$filled" "$dim" "$empty" "$reset" "$percent"
    sleep 0.045
  done

  printf '\n'
}

status() {
  local green='' reset=''
  if [[ -t 1 && "${TERM:-dumb}" != "dumb" && -z "${NO_COLOR:-}" ]]; then
    green=$'\033[38;5;82m'
    reset=$'\033[0m'
  fi
  printf '  %s> %s%s\n' "$green" "$1" "$reset"
}

show_intro
status 'BEGIN CONFIGURATION LINK'

while IFS= read -r -d '' source; do
  name="$(basename "$source" .symlink)"
  target="$HOME/.$name"

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    status "ALREADY LINKED      : $target"
    continue
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    mkdir -p "$backup_dir"
    mv "$target" "$backup_dir/$name"
    status "BACKUP CREATED      : $target"
  fi

  ln -s "$source" "$target"
  status "LINK ESTABLISHED   : $target → $source"
done < <(find "$repo_dir" -type f -name '*.symlink' -print0)

status 'BOOT SEQUENCE COMPLETE'
