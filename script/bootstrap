#!/usr/bin/env bash
# Link tracked configuration files into $HOME.
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
backup_dir="$HOME/.dotfiles-backup/$(date +%Y%m%d%H%M%S)"
install_terminal=false

case "${1:-}" in
  '') ;;
  --terminal) install_terminal=true ;;
  -h|--help)
    printf 'Usage: %s [--terminal]\n' "${BASH_SOURCE[0]}"
    exit 0
    ;;
  *)
    printf 'Unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac

show_intro() {
  [[ -t 1 && "${TERM:-dumb}" != "dumb" ]] || return
  printf '\n  DOTFILES\n\n'
}

print_status() {
  local color='' reset=''
  local color_code="$1"
  local message="$2"
  if [[ -t 1 && "${TERM:-dumb}" != "dumb" && -z "${NO_COLOR:-}" ]]; then
    color=$'\033['"$color_code"'m'
    reset=$'\033[0m'
  fi
  printf '  %s> %s%s\n' "$color" "$message" "$reset"
}

status() {
  print_status '38;5;245' "$1"
}

important() {
  print_status '38;5;82' "$1"
}

show_intro
status 'CONFIGURING DOTFILES'

while IFS= read -r -d '' source; do
  name="$(basename "$source" .symlink)"
  target="$HOME/.$name"
  status "CONFIGURING: $target"

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    status "ALREADY LINKED: $target"
    continue
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    mkdir -p "$backup_dir"
    mv "$target" "$backup_dir/$name"
    status "BACKUP CREATED: $target"
  fi

  ln -s "$source" "$target"
  status "LINK ESTABLISHED: $target → $source"
done < <(find "$repo_dir" -type f -name '*.symlink' -print0)

profile="$repo_dir/terminal/Xi.terminal"
if [[ "$install_terminal" == true && -f "$profile" ]]; then
  status 'CONFIGURING: Terminal.app profile'
  open "$profile"
  important 'TERMINAL PROFILE IMPORTED: Xi'
fi

important 'CONFIGURATION COMPLETE'
printf '\n'
