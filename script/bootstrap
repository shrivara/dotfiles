#!/usr/bin/env bash
# Link tracked configuration files into $HOME.
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
backup_dir="$HOME/.dotfiles-backup/$(date +%Y%m%d%H%M%S)"

show_intro() {
  # Keep logs clean when the script is run non-interactively.
  [[ -t 1 && "${TERM:-dumb}" != "dumb" ]] || return

  local green='' reset=''
  if [[ -z "${NO_COLOR:-}" ]]; then
    green=$'\033[38;5;82m'
    reset=$'\033[0m'
  fi
  printf '\n  %sDOTFILES%s\n\n' "$green" "$reset"
}

status() {
  local green='' reset=''
  if [[ -t 1 && "${TERM:-dumb}" != "dumb" && -z "${NO_COLOR:-}" ]]; then
    green=$'\033[38;5;82m'
    reset=$'\033[0m'
  fi
  printf '  %s> %s%s\n' "$green" "$1" "$reset"
}

show_intro
status 'BEGIN CONFIGURATION LINK'

while IFS= read -r -d '' source; do
  name="$(basename "$source" .symlink)"
  target="$HOME/.$name"

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    status "ALREADY LINKED: $target"
    continue
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    mkdir -p "$backup_dir"
    mv "$target" "$backup_dir/$name"
    status "BACKUP CREATED: $target"
  fi

  ln -s "$source" "$target"
  status "LINK ESTABLISHED: $target → $source"
done < <(find "$repo_dir" -type f -name '*.symlink' -print0)

status 'BOOT SEQUENCE COMPLETE'
printf '\n'
