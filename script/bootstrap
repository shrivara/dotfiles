#!/usr/bin/env bash
# Link tracked configuration files into $HOME and import the Terminal profile.
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
backup_dir="$HOME/.dotfiles-backup/$(date +%Y%m%d%H%M%S)"

show_intro() {
  # Keep logs clean when the script is run non-interactively.
  [[ -t 1 && "${TERM:-dumb}" != "dumb" ]] || return

  if [[ -n "${NO_COLOR:-}" ]]; then
    printf '\n  DOTFILES\n\n'
    return
  fi

  local dim=$'\033[38;5;245m'
  local bright=$'\033[38;5;255m'
  local reset=$'\033[0m'
  local scan row frame=0

  printf '\n'
  for scan in 0 1 2 3 4 5 4 3 2 1 0 all; do
    for row in 0 1 2 3 4 5; do
      if [[ "$scan" == 'all' || "$row" -eq "$scan" ]]; then
        printf '  %s' "$bright"
      else
        printf '  %s' "$dim"
      fi
      case "$row" in
        0) printf '________   ______________________________.___.____     ___________ _________%s\n' "$reset" ;;
        1) printf '\______ \  \_____  \__    ___/\_   _____/|   |    |    \_   _____//   _____/%s\n' "$reset" ;;
        2) printf ' |    |  \  /   |   \|    |    |    __)  |   |    |     |    __)_ \_____  \ %s\n' "$reset" ;;
        3) printf ' |    `   \/    |    \    |    |     \   |   |    |___  |        \/        \%s\n' "$reset" ;;
        4) printf '/_______  /\_______  /____|    \___  /   |___|_______ \/_______  /_______  /%s\n' "$reset" ;;
        5) printf '        \/         \/              \/                \/        \/        \/ %s\n' "$reset" ;;
      esac
    done
    frame=$((frame + 1))
    sleep 0.075
    [[ "$frame" -lt 12 ]] && printf '\033[6A'
  done
  printf '\n'
}

print_status() {
  local color='' reset=''
  local color_code="$1"
  local message="$2"
  if [[ -t 1 && "${TERM:-dumb}" != "dumb" && -z "${NO_COLOR:-}" ]]; then
    color=$'\033['"$color_code"'m'
    reset=$'\033[0m'
  fi
  printf '  %s> %s%s\n' "$color" "$message" "$reset"
}

status() {
  print_status '38;5;245' "$1"
}

important() {
  print_status '38;5;82' "$1"
}

show_intro
status 'BEGIN CONFIGURATION LINK'

while IFS= read -r -d '' source; do
  name="$(basename "$source" .symlink)"
  target="$HOME/.$name"
  status "CONFIGURING: $target"

  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    status "ALREADY LINKED: $target"
    continue
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    mkdir -p "$backup_dir"
    mv "$target" "$backup_dir/$name"
    status "BACKUP CREATED: $target"
  fi

  ln -s "$source" "$target"
  status "LINK ESTABLISHED: $target → $source"
done < <(find "$repo_dir" -type f -name '*.symlink' -print0)

profile="$repo_dir/terminal/Xi.terminal"
if [[ -f "$profile" ]]; then
  status 'CONFIGURING: Terminal.app profile'
  open "$profile"
  important 'TERMINAL PROFILE IMPORTED: Xi'
fi

important 'BOOT SEQUENCE COMPLETE'
printf '\n'
