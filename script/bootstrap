#!/usr/bin/env bash
# Link tracked configuration files into $HOME.
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
backup_dir="$HOME/.dotfiles-backup/$(date +%Y%m%d%H%M%S)"
case "${1:-}" in
  '') ;;
  -h|--help)
    printf 'Usage: %s\n' "${BASH_SOURCE[0]}"
    exit 0
    ;;
  *)
    printf 'Unknown option: %s\n' "$1" >&2
    exit 2
    ;;
esac

install_terminal_profile() {
  local profile="$1"
  local preferences

  preferences="$(mktemp)"
  if ! defaults export com.apple.Terminal "$preferences" 2>/dev/null; then
    : > "$preferences"
  fi

  python3 - "$preferences" "$profile" <<'PY'
import os
import plistlib
import sys

preferences_path, profile_path = sys.argv[1:]
prefs = {}
if os.path.getsize(preferences_path):
    with open(preferences_path, "rb") as file:
        prefs = plistlib.load(file)
with open(profile_path, "rb") as file:
    profile = plistlib.load(file)

name = profile["name"]
settings = prefs.setdefault("Window Settings", {})
settings[name] = profile
for duplicate in list(settings):
    suffix = duplicate.removeprefix(f"{name} ")
    if duplicate != name and suffix.isdigit():
        del settings[duplicate]
prefs["Default Window Settings"] = name

with open(preferences_path, "wb") as file:
    plistlib.dump(prefs, file, fmt=plistlib.FMT_XML, sort_keys=False)
PY
  defaults import com.apple.Terminal "$preferences"
  rm -f "$preferences"
}

show_intro() {
  if [[ ! -t 1 || "${TERM:-dumb}" == "dumb" ]]; then
    return 0
  fi
  printf '\n  DOTFILES\n\n'
}

status() {
  printf '  > %s\n' "$1"
}

important() {
  status "$1"
}

link_file() {
  local source="$1"
  local target="$2"
  local relative_target backup_path

  status "CONFIGURING: $target"
  if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
    status "ALREADY LINKED: $target"
    return
  fi

  if [[ -e "$target" || -L "$target" ]]; then
    relative_target="${target#"$HOME"/}"
    backup_path="$backup_dir/$relative_target"
    mkdir -p "$(dirname "$backup_path")"
    mv "$target" "$backup_path"
    status "BACKUP CREATED: $target"
  fi

  mkdir -p "$(dirname "$target")"
  ln -s "$source" "$target"
  status "LINK ESTABLISHED: $target → $source"
}

show_intro
status 'CONFIGURING DOTFILES'

while IFS= read -r -d '' source; do
  name="$(basename "$source" .symlink)"
  link_file "$source" "$HOME/.$name"
done < <(find "$repo_dir" -type f -name '*.symlink' -print0)

link_file "$repo_dir/pi/settings.json" "$HOME/.pi/agent/settings.json"
while IFS= read -r -d '' source; do
  link_file "$source" "$HOME/.pi/agent/extensions/$(basename "$source")"
done < <(find "$repo_dir/pi/extensions" -type f -print0)

while IFS= read -r -d '' source; do
  link_file "$source" "$HOME/.pi/agent/themes/$(basename "$source")"
done < <(find "$repo_dir/pi/themes" -type f -print0)

while IFS= read -r -d '' profile; do
  status "CONFIGURING: Terminal.app profile: $(basename "$profile")"
  install_terminal_profile "$profile"
done < <(find "$repo_dir/terminal" -maxdepth 1 -type f -name '*.terminal' -print0)
important 'TERMINAL PROFILES UPDATED (restart Terminal.app to apply)'

important 'CONFIGURATION COMPLETE'
printf '\n'
